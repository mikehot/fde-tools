#!/usr/bin/env python3
import os
import sys

# Resolve real path in case this script is invoked via a symlink
real_script_path = os.path.realpath(__file__)
toolkit_root = os.path.dirname(os.path.dirname(real_script_path))

if toolkit_root not in sys.path:
    sys.path.insert(0, toolkit_root)

from fde_tools.cli import main

if __name__ == "__main__":
    main()
